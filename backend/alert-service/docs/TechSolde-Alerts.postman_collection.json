{
  "info": {
    "_postman_id": "2abab58c-478c-51e0-938e-1203527de6ce",
    "name": "TechSolde Alert Service",
    "description": "CRUD, status workflow, filters, statistics and automatic detection for the Alert Service (port 5004). The detection folder creates and deletes a temporary [DEMO] promotion through the Promotion Service (port 5003). Run the folders in order.",
