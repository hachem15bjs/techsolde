PORT=5004
MONGODB_URI=mongodb://127.0.0.1:27017/techsolde_alerts
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Where the Alert Service reads promotions and coupons (Promotion Service REST API)
PROMOTION_API_URL=http://localhost:5003/api
PROMOTION_API_TIMEOUT_MS=5000

# Detection rule settings
EXPIRING_WITHIN_HOURS=24
HIGH_DISCOUNT_THRESHOLD=70
COUPON_USAGE_THRESHOLD=90
# Comma-separated rule types to switch off, e.g. high_discount,coupon_expiring
DISABLED_RULES=

# Automatic background scan every N minutes (0 = only manual "Scan Now")
AUTO_SCAN_INTERVAL_MINUTES=10
